# create directories and device nodes
::sysinit:/bin/prepare_fs.sh

# start SSH server
::respawn:/bin/dropbear -R -F -b /etc/banner.txt

# start logger
::respawn:/bin/metalog -N -C /etc/metalog.conf

# start radvd
::respawn:/bin/radvd -C /etc/radvd.conf -n -p /tmp/radvd.pid -m syslog

# start web server vor MQTT broker access
::respawn:/bin/httpd -f -p 80 -h /var/web -u nobody:nogroup -c /data/etc/httpd.conf

# start MQTT broker
::respawn:/bin/mosquitto -c /etc/mosquitto.conf

# start kickstarter
::respawn:/bin/python /root/kickstarter/kickstart.py -c /data/etc/kickstarter.json

::restart:/sbin/init
::shutdown:/sbin/halt
::ctrlaltdel:/sbin/reboot
