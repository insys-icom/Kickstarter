# create directories and device nodes
::sysinit:/bin/prepare_fs.sh

# create certificates
::sysinit:/bin/create_cert.sh

# start SSH server
::respawn:/bin/dropbear -R -F -b /etc/banner.txt

# start logger
::respawn:/bin/metalog -N -C /etc/metalog.conf

# start radvd
::respawn:/bin/radvd -C /etc/radvd.conf -n -p /tmp/radvd.pid -m syslog

# start web server
::respawn:/bin/httpd -D FOREGROUND -f /etc/httpd/httpd.conf

# start MQTT broker
::respawn:/bin/mosquitto -c /etc/mosquitto/mosquitto.conf

# start kickstarter
::respawn:/bin/python /root/kickstarter/kickstart.py -c /data/etc/kickstarter.json

::restart:/sbin/init
::shutdown:/sbin/halt
::ctrlaltdel:/sbin/reboot
